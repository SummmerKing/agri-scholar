            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using APSIM.Numerics;",
                "using Models.Climate;",
                "using System.Linq;",
                "using System;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.Soils;",
                "using Models.Utilities;",
                "using APSIM.Shared.Utilities;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock Clock;",
                "        [Link] private Fertiliser Fertiliser;",
                "        [Link] private Summary Summary;",
                "        [Link] private Soil Soil;",
                "        private Accumulator accumulatedRain;",
                "        [Link]",
                "        private ISoilWater waterBalance;",
                "        ",
                "        [Description(\"Crop\")]",
                "        public IPlant Crop { get; set; }",
                "",
                "        [Description(\"Start of sowing window (d-mmm)\")]",
                "        public string StartDate { get; set; }",
                "",
                "        [Description(\"End of sowing window (d-mmm)\")]",
                "        public string EndDate { get; set; }",
                "",
                "        [Description(\"Minimum extractable soil water for sowing (mm)\")]",
                "        public double MinESW { get; set; }",
                "",
                "        [Description(\"Accumulated rainfall required for sowing (mm)\")]",
                "        public double MinRain { get; set; }",
                "",
                "        [Description(\"Duration of rainfall accumulation (d)\")]",
                "        public int RainDays { get; set; }",
                "",
                "        [Display(Type = DisplayType.CultivarName)]",
                "        [Description(\"Cultivar to be sown\")]",
                "        public string CultivarName { get; set; }",
                "",
                "        [Description(\"Sowing depth (mm)\")]",
                "        public double SowingDepth { get; set; }",
                "",
                "        [Description(\"Row spacing (mm)\")]",
                "        public double RowSpacing { get; set; }",
                "",
                "        [Description(\"Plant population (/m2)\")]",
                "        public double Population { get; set; }",
                "        ",
                "        ",
                "        [EventSubscribe(\"StartOfSimulation\")]",
                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                "        {",
                "            accumulatedRain = new Accumulator(this, \"[Weather].Rain\", RainDays);",
                "        }",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            accumulatedRain.Update();",
                "            ",
                "            if (DateUtilities.WithinDates(StartDate, Clock.Today, EndDate) &&",
                "                !Crop.IsAlive &&",
                "                MathUtilities.Sum(waterBalance.ESW) > MinESW &&",
                "                accumulatedRain.Sum > MinRain)",
                "            {",
                "                Crop.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                "            }",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [
                {
                  "Key": "Crop",
                  "Value": "[Maize]"
                },
                {
                  "Key": "StartDate",
                  "Value": "01-aug"
                },
                {
                  "Key": "EndDate",
                  "Value": "30-aug"
                },
                {
                  "Key": "MinESW",
                  "Value": "25"
                },
                {
                  "Key": "MinRain",
                  "Value": "20"
                },
                {
                  "Key": "RainDays",
                  "Value": "3"
                },
                {
                  "Key": "CultivarName",
                  "Value": "MAH-14-138"
                },
                {
                  "Key": "SowingDepth",
                  "Value": "50"
                },
                {
                  "Key": "RowSpacing",
                  "Value": "750"
                },
                {
                  "Key": "Population",
                  "Value": "5.5"
                }
              ],
              "Name": "Sow using a variable rule",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using Models.Core;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private IClock Clock;",
                "        [Link] private ISummary Summary;",
                "        [Link] private Irrigation Irrigation;",
                "",
                "        //==========================================================",
                "        // OPTUNA PARAMETERS",
                "        //==========================================================",
                "",
                "        [Description(\"Irrigation amount (mm) for each slot. 0 = inactive\")]",
                "        public double[] Amount = new double[6]",
                "        {",
                "            0,0,0,0,0,0",
                "        };",
                "",
                "        [Description(\"Week after sowing (0-17)\")]",
                "        public int[] Week = new int[6]",
                "        {",
                "           40,40,40,40,40,40",
                "        };",
                "",
                "        [Description(\"Application depth (mm). 0 = surface irrigation\")]",
                "        public double[] Depth = new double[6]",
                "        {",
                "            0,2,4,6,8,10",
                "        };",
                "",
                "        [Description(\"Runoff flag (0 = false, 1 = true)\")]",
                "        public int[] WillRunoff = new int[6]",
                "        {",
                "            1,1,1,1,1,1",
                "        };",
                "",
                "        //==========================================================",
                "        // INTERNAL VARIABLES",
                "        //==========================================================",
                "",
                "        private DateTime sowingDate;",
                "        private bool cropSown = false;",
                "        private int lastWeek = -1;",
                "        private bool[] applied = new bool[6];",
                "",
                "        //==========================================================",
                "        // INITIALISE",
                "        //==========================================================",
                "",
                "        [EventSubscribe(\"Sowing\")]",
                "        private void OnSowing(object sender, EventArgs e)",
                "        {",
                "            cropSown = true;",
                "            sowingDate = Clock.Today;",
                "            lastWeek = -1;",
                "",
                "            for (int i = 0; i < applied.Length; i++)",
                "                applied[i] = false;",
                "        }",
                "",
                "        //==========================================================",
                "        // APPLY IRRIGATION",
                "        //==========================================================",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (!cropSown)",
                "                return;",
                "",
                "            int das = (Clock.Today - sowingDate).Days;",
                "            int currentWeek = das / 7;",
                "",
                "            if (currentWeek == lastWeek)",
                "                return;",
                "",
                "            lastWeek = currentWeek;",
                "",
                "            int n = Math.Min(",
                "                        Amount.Length,",
                "                        Math.Min(",
                "                            Week.Length,",
                "                            Math.Min(",
                "                                Depth.Length,",
                "                                WillRunoff.Length)));",
                "",
                "            for (int i = 0; i < n; i++)",
                "            {",
                "                if (applied[i])",
                "                    continue;",
                "",
                "                if (Week[i] != currentWeek)",
                "                    continue;",
                "",
                "                if (Amount[i] <= 0)",
                "                    continue;",
                "",
                "                try",
                "                {",
                "                    if (Depth[i] > 0)",
                "                    {",
                "                        Irrigation.Apply(",
                "                            amount: Amount[i],",
                "                            depth: Depth[i],",
                "                            willRunoff: (WillRunoff[i] == 1));",
                "                    }",
                "                    else",
                "                    {",
                "                        Irrigation.Apply(",
                "                            amount: Amount[i],",
                "                            willRunoff: (WillRunoff[i] == 1));",
                "                    }",
                "",
                "                    applied[i] = true;",
                "",
                "                    Summary.WriteMessage(",
                "                        this,",
                "                        $\"Applied {Amount[i]:F2} mm irrigation at {das} DAS (Week {currentWeek}, Depth={Depth[i]:F0} mm, Runoff={(WillRunoff[i] == 1)})\",",
                "                        MessageType.Information);",
                "                }",
                "                catch (Exception ex)",
                "                {",
                "                    Summary.WriteMessage(",
                "                        this,",
                "                        $\"Failed irrigation slot {i + 1}: {ex.Message}\",",
                "                        MessageType.Warning);",
                "                }",
                "            }",
                "        }",
                "",
                "        //==========================================================",
                "        // END OF CROP",
                "        //==========================================================",
                "",
                "        [EventSubscribe(\"Harvesting\")]",
                "        private void OnHarvesting(object sender, EventArgs e)",
                "        {",
                "            cropSown = false;",
                "        }",
                "    }",
                "}"
              ],
              "Parameters": [],
              "Name": "IrrigationManager",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using System;",
                "using Models.Core;",
                "using Models.Interfaces;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private IClock Clock;",
                "        [Link] private ISummary Summary;",
                "        [Link] private Fertiliser Fertiliser;",
                "",
                "        //==========================================================",
                "        // OPTUNA PARAMETERS",
                "        //==========================================================",
                "",
                "        [Description(\"Fertiliser product for each slot\")]",
                "        public string[] ProductType = new string[6]",
                "        {",
                "            \"UreaN\", \"UreaN\", \"UreaN\", \"UreaN\", \"UreaN\", \"UreaN\"",
                "        };",
                "",
                "        [Description(\"Application amount (0 = inactive)\")]",
                "        public double[] Amount = new double[6]",
                "        {",
                "            50,50,50,0,0,0",
                "        };",
                "",
                "        [Description(\"Application week after sowing (0-17)\")]",
                "        public int[] Week = new int[6]",
                "        {",
                "            0,4,8,0,0,0",
                "        };",
                "",
                "        //==========================================================",
                "        // INTERNAL VARIABLES",
                "        //==========================================================",
                "",
                "        private DateTime sowingDate;",
                "        private bool cropSown = false;",
                "        private int lastWeek = -1;",
                "        private bool[] applied = new bool[6];",
                "",
                "        //==========================================================",
                "        // INITIALISE",
                "        //==========================================================",
                "",
                "        [EventSubscribe(\"Sowing\")]",
                "        private void OnSowing(object sender, EventArgs e)",
                "        {",
                "            cropSown = true;",
                "            sowingDate = Clock.Today;",
                "            lastWeek = -1;",
                "",
                "            for (int i = 0; i < applied.Length; i++)",
                "                applied[i] = false;",
                "        }",
                "",
                "        //==========================================================",
                "        // APPLY FERTILISER",
                "        //==========================================================",
                "",
                "        [EventSubscribe(\"DoManagement\")]",
                "        private void OnDoManagement(object sender, EventArgs e)",
                "        {",
                "            if (!cropSown)",
                "                return;",
                "",
                "            int das = (Clock.Today - sowingDate).Days;",
                "            int currentWeek = das / 7;",
                "",
                "            if (currentWeek == lastWeek)",
                "                return;",
                "",
                "            lastWeek = currentWeek;",
                "",
                "            int n = Math.Min(ProductType.Length,",
                "                    Math.Min(Amount.Length, Week.Length));",
                "",
                "            for (int i = 0; i < n; i++)",
                "            {",
                "                if (applied[i])",
                "                    continue;",
                "",
                "                if (Week[i] != currentWeek)",
                "                    continue;",
                "",
                "                if (Amount[i] <= 0)",
                "                    continue;",
                "",
                "                if (string.IsNullOrWhiteSpace(ProductType[i]))",
                "                    continue;",
                "",
                "                try",
                "                {",
                "                    Fertiliser.Apply(Amount[i], ProductType[i]);",
                "",
                "                    applied[i] = true;",
                "",
                "                    Summary.WriteMessage(",
                "                        this,",
                "                        $\"Applied {Amount[i]:F2} kg/ha of {ProductType[i]} at {das} DAS (Week {currentWeek})\",",
                "                        MessageType.Information);",
                "                }",
                "                catch (Exception ex)",
                "                {",
                "                    Summary.WriteMessage(",
                "                        this,",
                "                        $\"Failed to apply slot {i + 1}: {ProductType[i]} ({ex.Message})\",",
                "                        MessageType.Warning);",
                "                }",
                "            }",
                "        }",
                "",
                "        //==========================================================",
                "        // END OF CROP",
                "        //==========================================================",
                "",
                "        [EventSubscribe(\"Harvesting\")]",
                "        private void OnHarvesting(object sender, EventArgs e)",
                "        {",
                "            cropSown = false;",
                "        }",
                "    }",
                "}"
              ],
